# Neon Auth (Managed Better Auth) for the tin-ops-console project. Copy to .env.local.
NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
# At least 32 characters. Generate: python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
NEON_AUTH_COOKIE_SECRET=
# Read-only connection string for the console_reader role (status store). Optional: pages show a notice when unset.
CONSOLE_DATABASE_URL=
# Connection string for the console_admin role (registry writes). Server-only; never prefix with NEXT_PUBLIC_.
# Without it the registry is read-only and the admin forms are hidden.
CONSOLE_ADMIN_DATABASE_URL=
# Optional. Enables "Fix with agent" on Drift for admins. A fine-grained GitHub token (resource owner: the org) on the
# repositories the registry lists, with Issues: read and write, and Contents: read (so the console can check the repo's
# real pin before it raises a ticket; without Contents it still works but says it could not check). It opens an issue
# that mentions @claude, which needs the Claude workflow (claude.yml) in that repo.
AGENT_GITHUB_TOKEN=
# Optional. Also open a platform support ticket in the care hub (konnect-ops) for each hand-off, and resolve it when
# the declared pin is updated. CARE_HUB_INTAKE_URL is the full URL of konnect-ops POST /api/platform/support/intake
# (https only); CARE_HUB_INTAKE_TOKEN is the same value as SUPPORT_INTAKE_TOKEN set on that app. Server-only.
CARE_HUB_INTAKE_URL=
CARE_HUB_INTAKE_TOKEN=
