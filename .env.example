# Neon Auth (Managed Better Auth) for the tin-ops-console project (the TIN Control Plane). Copy to .env.local.
NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
# At least 32 characters. Generate: python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
NEON_AUTH_COOKIE_SECRET=
# Read-only connection string for the console_reader role (status store). Optional: pages show a notice when unset.
CONSOLE_DATABASE_URL=
# Connection string for the console_admin role (registry writes). Server-only; never prefix with NEXT_PUBLIC_.
# Without it the registry is read-only and the admin forms are hidden.
CONSOLE_ADMIN_DATABASE_URL=
# Optional. Enables "Fix with agent" on Drift for admins: a fine-grained GitHub token with Issues: read and write on the
# repositories the registry lists. It opens an issue that mentions @claude, which needs the Claude GitHub app on that repo.
AGENT_GITHUB_TOKEN=
# Optional. Enables "Collect now" on the Collector page for admins: a fine-grained GitHub token with Actions: read and write
# on the collector repository. It starts that repo's collect.yml workflow (workflow_dispatch); the console never writes snapshots itself.
COLLECTOR_GITHUB_TOKEN=
# Optional overrides. Defaults: tindevelopers/shell-base-github-registry and collect.yml.
COLLECTOR_REPO=
COLLECTOR_WORKFLOW=
# Optional. Enables "Declared versus reported" on a project page: what each platform environment reports to BOSS (GET /v1/reports),
# shown against the declared pins for @tindevelopers/knowledge, @tindevelopers/knowledge-worker and @tindevelopers/credential-crypto. Read on the server only.
# BOSS_API_URL is the BOSS cell's base URL (https; http is accepted for localhost). BOSS_REPORTS_KEY is the console's OWN spoke key,
# minted by the owner in program "tin" with boss.reports.read as its only scope. Never prefix either with NEXT_PUBLIC_.
# Without them the section says the reports are not configured and nothing is shown as deployed.
BOSS_API_URL=
BOSS_REPORTS_KEY=
# Multi-tenancy (db/006_tenants.sql). All optional; the defaults suit the single TIN tenant.
# Base domain: a request to <tenant>.<base> is for that tenant; the bare base is the default tenant.
CONTROL_BASE_DOMAIN=
# Tenant used for the bare base domain (and for other hosts unless they are rejected). Default: tin.
DEFAULT_TENANT=
# Set to "reject" once tenant subdomains are live, so an unknown host is a 404 instead of the default tenant.
TENANT_OTHER_HOSTS=
# Optional. Enables "Send to BOSS" on the BOSS › Pin proposals page for admins: the console's OPERATOR spoke key, minted by the owner
# in program "tin" for platform "console" with boss.pins.write (a subset of the operator scopes; never mixed with boss.reports.read).
# BOSS also requires the signed-in person's Neon Auth token and that person on BOSS's operator list; the console forwards the token.
# The same key serves BOSS › Releases (needs boss.releases.write) and BOSS › Review queue (needs boss.knowledge.write): mint it with
# the operator scopes those pages need, still never mixed with boss.reports.read. A cell serves releases and the queue only when its
# configuration enables them (tin-production has no knowledge login); the pages say so when the cell answers 404.
# Server-only; never prefix with NEXT_PUBLIC_. Without it the page still builds drafts but cannot send.
BOSS_OPERATOR_KEY=

# The console's credentials key, for the Keys page (/boss/keys): lists BOSS's spoke keys (metadata only, never a key) and
# lets an admin revoke one. Minted by the owner in tin-boss-api for platform "console" with boss.credentials.write ONLY, as a
# key of its own: it reaches every platform's keys, so it is never added to the operator key above or the reports key.
# BOSS also requires the signed-in person's Neon Auth token and that person on its operator list. BOSS_API_URL is shared.
# Server-only; never prefix with NEXT_PUBLIC_. Without it the page says keys are not configured.
BOSS_CREDENTIALS_KEY=
